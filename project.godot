; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node",
"class": "AudioDirector",
"language": "GDScript",
"path": "res://src/systems/audio_director.gd"
}, {
"base": "AudioStreamPlayer",
"class": "BreathAudio",
"language": "GDScript",
"path": "res://spike/breath_audio.gd"
}, {
"base": "Node",
"class": "BreathClock",
"language": "GDScript",
"path": "res://spike/breath_clock.gd"
}, {
"base": "Reference",
"class": "BreathModel",
"language": "GDScript",
"path": "res://spike/breath_model.gd"
}, {
"base": "Node2D",
"class": "BreathVisual",
"language": "GDScript",
"path": "res://spike/breath_visual.gd"
}, {
"base": "Camera",
"class": "ClimbCamera",
"language": "GDScript",
"path": "res://src/systems/climb_camera.gd"
}, {
"base": "Spatial",
"class": "ClimbHold",
"language": "GDScript",
"path": "res://src/nodes/climb_hold.gd"
}, {
"base": "Node",
"class": "ClimbSystem",
"language": "GDScript",
"path": "res://src/systems/climb_system.gd"
}, {
"base": "Node",
"class": "EcologySystem",
"language": "GDScript",
"path": "res://src/systems/ecology_system.gd"
}, {
"base": "Node",
"class": "HapticProbe",
"language": "GDScript",
"path": "res://spike/haptic_probe.gd"
}, {
"base": "Node",
"class": "SoundscapeSystem",
"language": "GDScript",
"path": "res://src/systems/soundscape_system.gd"
} ]
_global_script_class_icons={
"AudioDirector": "",
"BreathAudio": "",
"BreathClock": "",
"BreathModel": "",
"BreathVisual": "",
"ClimbCamera": "",
"ClimbHold": "",
"ClimbSystem": "",
"EcologySystem": "",
"HapticProbe": "",
"SoundscapeSystem": ""
}

[application]

config/name="Komorebi"
config/description="4-7-8 breathing companion. Increment 0 de-risks haptic/audio/visual sync."
run/main_scene="res://src/level/vertical_slice.tscn"
config/icon="res://icon.svg"
config/features=PoolStringArray( "3.5", "GLES3" )
run/max_fps=60

[autoload]

TelemetryService="*res://autoload/telemetry_service.gd"
SaveService="*res://autoload/save_service.gd"
SteamService="*res://autoload/steam_service.gd"
InputRouter="*res://autoload/input_router.gd"
GameDirector="*res://autoload/game_director.gd"

[debug]

gdscript/warnings/return_value_discarded=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/untyped_declaration=1

[display]

window/stretch/mode="2d"
window/stretch/aspect="keep"
window/size/viewport_width=1280
window/size/viewport_height=800

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

environment/defaults/default_clear_color=Color( 0.086, 0.098, 0.129, 1 )
